# salvi: un vi en sal para Linux y soso.
#
#   salvi [+N] [fichero]
import "editor/editor.sal"
import "editor/ex.sal"

fn usage() -> Unit ! io
    _p = print_str("uso: salvi [+N] [fichero]\n")

fn main() -> Int ! io, alloc
    path = d""
    line = 0
    i = 1
    while i < argc()
        a = argv(i)
        if a.eq(d"-h") == 1 || a.eq(d"--help") == 1
            usage()
            return 0
        if a.len() > 1 && a.char(0) == 43
            line = parse_int(&a.slice(1, a.len()))
        else
            path = a
        i = i + 1
    ed = Editor.open(&path)
    ed.run(line)
    0
